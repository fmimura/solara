# Copie para .env.local e preencha com os valores do seu projeto.
# Painel Supabase: Project Settings -> API

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon / publishable). Pode ir para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (secret). NUNCA expor no browser; usada so em rotas de API.
SUPABASE_SERVICE_ROLE_KEY=

# API da Anthropic (usada a partir da secao Motor)
ANTHROPIC_API_KEY=
